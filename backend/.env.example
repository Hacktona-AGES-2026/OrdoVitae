# Copie para backend/.env (o .env não vai para o git) e preencha.

# Justificativa redigida por LLM (DeepSeek). Sem chave, cai no template curto.
ORDO_REDATOR=llm
DEEPSEEK_API_KEY=
ORDO_MODELO_LLM=deepseek-flash

